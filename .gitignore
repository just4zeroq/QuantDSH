# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
build/
src-tauri/target/
src-tauri/gen/schemas/
node_modules/
dist-js/
# Profile fork (profile/) keeps sources only; its build output is regenerated.
profile/packages/**/dist/
profile/apps/web/dist/
profile/**/.turbo/

# ---------------------------------------------------------------------------
# Runtime / installer artefacts
# These are produced by scripts/pack:runtime at release time and include a
# ~276 MB third-party runtime bundle plus NSIS/MSI installers.
# ---------------------------------------------------------------------------
*.nsis.zip
*.nsis.zip.sig
*.msi
*.msi.zip
*.deb
*.rpm
*.AppImage
*.dmg
*.app.tar.gz
*.app.tar.gz.sig

# The data service used to be a Rust sidecar; the staged binary is an input to
# `cargo build`/`tauri build`, never a source.
src-tauri/binaries/
src-tauri/quantdsh-datahub-*.exe

# Python data service: the local venv and the bundled interpreter are build
# inputs (scripts/prepare-python-runtime.mjs regenerates them), not sources.
services/datahub-api/.venv/
services/datahub-api/__pycache__/
services/datahub-api/**/__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Local agent workspace (memory, skills cache); machine-specific.
.workbuddy/

# ---------------------------------------------------------------------------
# Logs and ad-hoc capture files
# ---------------------------------------------------------------------------
*.log
build-output.txt
check-output.txt

# ---------------------------------------------------------------------------
# Local environment / secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Local-only documents
# 内部调研与上游对照资料：只保留在本地工作区，不随仓库发布。
# ---------------------------------------------------------------------------
QUANTDSH_REFERENCE_RESEARCH.md
QUANTDSH_UPSTREAM_NOTES.local.md
*.local.md

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
