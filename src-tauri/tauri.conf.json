{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/config.schema.json",
  "productName": "QuantDSH",
  "mainBinaryName": "QuantDSH",
  "version": "3.0.0-alpha.3",
  "identifier": "io.quantdsh.dsh.ssh",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "freezePrototype": false,
      "dangerousDisableAssetCspModification": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "QuantDSH",
    "copyright": "QuantDSH",
    "licenseFile": "../THIRD_PARTY_NOTICES.md",
    "shortDescription": "QuantDSH",
    "longDescription": "QuantDSH carrier for a pinned DeepSeek Harness runtime Profile",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/quantdsh-runtime": "quantdsh-runtime",
      "../build/deployment/quantdsh-config.json": "quantdsh-config.json",
      "../services/datahub-api/app": "datahub-api/app",
      "../services/datahub-api/requirements.txt": "datahub-api/requirements.txt",
      "../build/python-runtime": "runtime"
    },
    "macOS": {
      "entitlements": "entitlements.mac.plist",
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "bundleName": "QuantDSH"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh",
        "compression": "lzma"
      }
    }
  }
}
